# Skopiuj do .env i uzupełnij.

# Adres, pod którym będzie strona. Bez własnej domeny użyj sslip.io:
# zamień kropki w publicznym IP serwera na myślniki, np. serwer 203.0.113.10 -> 203-0-113-10.sslip.io
DOMAIN=203-0-113-10.sslip.io

# Tajne hasło dostępu do agenta (wymyśl długie, losowe). Adres strony: https://DOMAIN/?token=TO_HASLO
VOICE_AGENT_TOKEN=zmien-mnie-na-dlugie-losowe-haslo

# Opcjonalnie: klucz API zamiast logowania subskrypcją (płatność za użycie).
# ANTHROPIC_API_KEY=sk-ant-...

# Opcjonalnie: model Whisper (base = szybciej, small = domyślnie, medium = dokładniej)
# WHISPER_MODEL=small
# Opcjonalnie: szybszy/tańszy model Claude
# CLAUDE_MODEL=sonnet
# Opcjonalnie: pozwól Claude edytować pliki w /work bez pytania
# CLAUDE_PERMISSION_MODE=acceptEdits
